# GeoAttend Deployment Environment Variables (Backend)
#
# COPY this file to a new file named `.env` locally for development.
# DO NOT commit the `.env` file to version control.
#
# For production (e.g., Render), add these exact variables in the Environment UI.

# Port for the Node.js server (Render assigns this automatically in production)
PORT=5000

# MongoDB Connection String (from MongoDB Atlas Free Tier)
# Ensure you replace <password> and <username> with your actual database credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/geoattend?retryWrites=true&w=majority

# Secret key used for signing JSON Web Tokens
# Generate a strong, random 32-character string for production!
JWT_SECRET=your_super_secret_jwt_key_here_12345

# Allowed Client Origin (Crucial for proper CORS configuration)
# Example locally: http://localhost:3000
# Example in production: https://geoattend-app.vercel.app
CLIENT_URL=http://localhost:3000
