# GeoAttend Deployment Environment Variables (Frontend)
#
# COPY this file to a new file named `.env` locally for development.
# DO NOT commit the `.env` file to version control.
#
# For production (e.g., Vercel), add these exact variables in the project settings UI.

# The base URL of your deployed Express backend (no trailing slash)
# Example locally: http://localhost:5000/api
# Example in production: https://geoattend-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
